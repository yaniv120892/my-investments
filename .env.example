# Matches the docker-compose Postgres, which sets no user or database and so
# defaults both to `postgres`.
DATABASE_URL=postgresql://postgres:testpass@localhost:5432/postgres?schema=public

# The unpooled endpoint. Two things need it: `prisma migrate`, because a
# transaction pooler does not hold the advisory lock it takes, and the advisor's
# Mastra memory store, which opens plain Postgres connections and creates its own
# tables. On Neon this is the host WITHOUT `-pooler`; the local Postgres below
# has none, so it matches DATABASE_URL above. `prisma generate` and `next build`
# do not read it, so a deploy never breaks on it — but `npm run db:migrate`
# fails without it, and the advisor answers statelessly.
DIRECT_URL=postgresql://postgres:testpass@localhost:5432/postgres?schema=public
# Overrides DIRECT_URL for the memory store alone. Leave unset.
MASTRA_DB_URL=

SESSION_TTL_MINUTES=
JWT_SECRET=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=

# Unset disables Telegram alerts; snapshots still run.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Unset makes every US equity fail to price.
FINNHUB_API_KEY=

# chatgpt (default) | gemini. Unset means chatgpt.
AI_PROVIDER=
# Unset makes /advisor answer 503; every other page is unaffected.
OPENAI_API_KEY=
GEMINI_API_KEY=
# Model override, as "provider/model". Unset uses openai/gpt-4o.
ASSISTANT_MODEL_ID=
# Points the provider at another OpenAI-compatible base URL, for a test mock.
ASSISTANT_MODEL_URL=

# Shared secret authorizing GET/POST /api/snapshot. Use a random string of at
# least 16 characters. On Vercel, setting this on the project makes Vercel Cron
# send it automatically as an "Authorization: Bearer <value>" header.
CRON_SECRET=

# Read by `npm run snapshot:trigger` (e.g. https://your-app.vercel.app)
SNAPSHOT_BASE_URL=

# Which user the one-off import scripts attach holdings to. Both
# db:import-sheet and db:add-savings refuse to run without it.
IMPORT_USER_EMAIL=
