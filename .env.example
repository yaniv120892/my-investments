DATABASE_URL=

# Session Management
SESSION_TTL_MINUTES=
JWT_SECRET=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email Configuration (Gmail recommended)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=

# Telegram Bot (Optional - for notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Market Data APIs
FINNHUB_API_KEY=

# Scheduled Snapshots
# Shared secret authorizing GET/POST /api/snapshot. Use a random string of at
# least 16 characters. On Vercel, setting this on the project makes Vercel Cron
# send it automatically as an "Authorization: Bearer <value>" header.
CRON_SECRET=

# Base URL used by `npm run snapshot:trigger` (e.g. https://your-app.vercel.app)
SNAPSHOT_BASE_URL=
