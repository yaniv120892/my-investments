{
  "name": "my-investments",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate --schema src/prisma/schema.prisma && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0 --report-unused-disable-directives",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prettier": "npm run format:check",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:watch": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run --exclude '**/*.contract.test.ts'",
    "test:contract": "vitest run contract.test",
    "db:import-sheet": "tsx scripts/importFromSheet.ts",
    "db:add-savings": "tsx scripts/addSavingsHoldings.ts",
    "snapshot:trigger": "tsx scripts/triggerSnapshot.ts",
    "db:generate": "prisma generate --schema src/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema src/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema src/prisma/schema.prisma",
    "db:studio": "prisma studio --schema src/prisma/schema.prisma",
    "setup": "npm run db:generate && npm run db:migrate",
    "postinstall": "prisma generate --schema src/prisma/schema.prisma"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@mui/material-nextjs": "^7.3.10",
    "@prisma/client": "^6.13.0",
    "@tanstack/react-query": "^5.84.1",
    "@tanstack/react-query-devtools": "^5.84.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^6.4.17",
    "@upstash/redis": "^1.35.3",
    "bcryptjs": "^3.0.2",
    "chart.js": "^4.5.0",
    "jsonwebtoken": "^9.0.2",
    "next": "15.4.10",
    "nodemailer": "^7.0.5",
    "prisma": "^6.13.0",
    "react": "19.1.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "19.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.4.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-promise": "^7.3.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "typescript-eslint": "^8.67.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^2.1.9"
  },
  "prisma": {
    "schema": "src/prisma/schema.prisma"
  }
}
